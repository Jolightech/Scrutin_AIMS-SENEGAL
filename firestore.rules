rules_version = '2';

// Règles de sécurité de la plateforme de vote AIMS Sénégal (Firestore).
// À coller dans la console Firebase : Firestore Database > Règles.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function validType(type) {
      return type in ['academic', 'health', 'online', 'logistics'];
    }

    function scrutinOpen(type) {
      return get(/databases/$(database)/documents/config/scrutins).data[type].status == 'open';
    }

    // Seules les adresses institutionnelles ...@aims-senegal.org (et sous-domaines).
    function institutional(email) {
      return email is string
        && email.size() < 120
        && email.matches('^[a-z0-9._%+-]+@([a-z0-9-]+[.])*aims-senegal[.]org$');
    }

    // Réglages et candidats : lecture publique, écriture par l'administration.
    match /config/scrutins {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Premier administrateur : réclamé une seule fois (voir js/cloud.js).
    match /config/owner {
      allow get: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && existsAfter(/databases/$(database)/documents/admins/$(request.auth.uid));
      allow update, delete: if false;
    }

    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && !exists(/databases/$(database)/documents/config/owner)
        && existsAfter(/databases/$(database)/documents/config/owner);
      allow update, delete: if false;
    }

    // Bulletins : anonymes (aucune adresse), lecture publique pour les
    // résultats en direct, jamais modifiés ; effacés par l'administration.
    match /ballots/{id} {
      allow read: if true;
      allow create: if validType(request.resource.data.type)
        && scrutinOpen(request.resource.data.type)
        && request.resource.data.keys().hasOnly(['type', 'choices', 'blank', 'receipt', 'at'])
        && request.resource.data.choices is list
        && request.resource.data.choices.size() <= 3
        && request.resource.data.blank is bool
        && (request.resource.data.blank || request.resource.data.choices.size() > 0)
        && request.resource.data.receipt is string
        && request.resource.data.receipt.size() < 20
        && request.resource.data.at == request.time;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Liste d'émargement : une entrée par adresse et par scrutin.
    // Création seulement : un second vote au même scrutin est refusé.
    // La liste complète n'est lisible que par l'administration.
    match /voters/{key} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if validType(request.resource.data.type)
        && scrutinOpen(request.resource.data.type)
        && institutional(request.resource.data.email)
        && key == request.resource.data.email + '__' + request.resource.data.type
        && request.resource.data.keys().hasOnly(['email', 'type', 'at'])
        && request.resource.data.at == request.time;
      allow update: if false;
      allow delete: if isAdmin();
    }
  }
}
