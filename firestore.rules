rules_version = '2';

// Règles de sécurité de la plateforme de vote AIMS Sénégal (Firestore).
// À coller dans la console Firebase : Firestore Database > Règles.
service cloud.firestore {
  match /databases/{database}/documents {

    // Administrateur : compte propriétaire (admins/{uid}) ou adresse Google
    // vérifiée ajoutée par un administrateur (adminEmails/{email}).
    function isAdmin() {
      return request.auth != null
        && (exists(/databases/$(database)/documents/admins/$(request.auth.uid))
          || (request.auth.token.email_verified == true
            && exists(/databases/$(database)/documents/adminEmails/$(request.auth.token.email))));
    }

    function validType(type) {
      return type in ['academic', 'health', 'online', 'logistics'];
    }

    function scrutinOpen(type) {
      return get(/databases/$(database)/documents/config/scrutins).data[type].status == 'open';
    }

    // Choix valides : candidats du scrutin, sans doublon, au plus « max »,
    // et aucun candidat si c'est un vote blanc.
    function validChoices(type, choices, blank) {
      let cfg = get(/databases/$(database)/documents/config/scrutins).data[type];
      return choices is list
        && choices.size() <= cfg.max
        && choices.toSet().size() == choices.size()
        && choices.hasOnly(cfg.ids)
        && (blank ? choices.size() == 0 : choices.size() > 0);
    }

    // Seules les adresses institutionnelles ...@aims-senegal.org (et sous-domaines).
    function institutional(email) {
      return email is string
        && email.size() < 120
        && email.matches('^[a-z0-9._%+-]+@([a-z0-9-]+[.])*aims-senegal[.]org$');
    }

    // Réglages et candidats : lecture publique, écriture par l'administration.
    match /config/scrutins {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Premier administrateur : réclamé une seule fois (voir js/cloud.js).
    match /config/owner {
      allow get: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && existsAfter(/databases/$(database)/documents/admins/$(request.auth.uid));
      allow update, delete: if false;
    }

    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && !exists(/databases/$(database)/documents/config/owner)
        && existsAfter(/databases/$(database)/documents/config/owner);
      allow update, delete: if false;
    }

    // Adresses des administrateurs supplémentaires.
    match /adminEmails/{email} {
      allow get: if request.auth != null && (request.auth.token.email == email || isAdmin());
      allow list: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['email', 'by', 'at'])
        && request.resource.data.email == email
        && request.resource.data.at == request.time;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Votant : compte connecté dont l'adresse @aims-senegal.org est confirmée
    // (lien reçu par email, ou compte Google à cette adresse).
    function verifiedVoter() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && institutional(request.auth.token.email);
    }

    function voterPath(type) {
      return /databases/$(database)/documents/voters/$(request.auth.token.email + '__' + type);
    }

    function tallyPath(type) {
      return /databases/$(database)/documents/tallies/$(type);
    }

    function previousCount(type) {
      return exists(tallyPath(type)) ? get(tallyPath(type)).data.n : 0;
    }

    // Un vote = un bulletin + l'émargement de l'adresse + le compteur du
    // scrutin, écrits ensemble. Le compteur augmente d'exactement 1 et désigne
    // le bulletin : impossible de glisser plusieurs bulletins à la fois, ou un
    // bulletin sans émargement (donc deux fois avec la même adresse).
    match /tallies/{type} {
      allow read: if true;
      allow create, update: if verifiedVoter()
        && validType(type)
        && scrutinOpen(type)
        && request.resource.data.keys().hasOnly(['n', 'last'])
        && request.resource.data.n == previousCount(type) + 1
        && request.resource.data.last is string
        && !exists(/databases/$(database)/documents/ballots/$(request.resource.data.last))
        && existsAfter(/databases/$(database)/documents/ballots/$(request.resource.data.last))
        && !exists(voterPath(type))
        && existsAfter(voterPath(type));
      allow delete: if false;
    }

    // Bulletins : anonymes (aucune adresse), lecture publique pour les
    // résultats en direct, jamais modifiés ; effacés par l'administration.
    match /ballots/{id} {
      allow read: if true;
      allow create: if verifiedVoter()
        && validType(request.resource.data.type)
        && scrutinOpen(request.resource.data.type)
        && request.resource.data.keys().hasOnly(['type', 'choices', 'blank', 'receipt', 'at'])
        && request.resource.data.blank is bool
        && validChoices(request.resource.data.type, request.resource.data.choices, request.resource.data.blank)
        && request.resource.data.receipt is string
        && request.resource.data.receipt.size() < 20
        && request.resource.data.at == request.time
        && getAfter(tallyPath(request.resource.data.type)).data.last == id
        && getAfter(tallyPath(request.resource.data.type)).data.n == previousCount(request.resource.data.type) + 1;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Liste d'émargement : une entrée par adresse et par scrutin, sans date
    // (pour ne pas pouvoir la rapprocher d'un bulletin). Création seulement :
    // un second vote au même scrutin est refusé. Chacun ne lit que la sienne.
    match /voters/{key} {
      allow get: if isAdmin()
        || (request.auth != null && key.split('__')[0] == request.auth.token.email);
      allow list: if isAdmin();
      allow create: if verifiedVoter()
        && validType(request.resource.data.type)
        && scrutinOpen(request.resource.data.type)
        && request.resource.data.email == request.auth.token.email
        && key == request.resource.data.email + '__' + request.resource.data.type
        && request.resource.data.keys().hasOnly(['email', 'type'])
        && existsAfter(tallyPath(request.resource.data.type))
        && getAfter(tallyPath(request.resource.data.type)).data.n == previousCount(request.resource.data.type) + 1;
      allow update: if false;
      allow delete: if isAdmin();
    }
  }
}
